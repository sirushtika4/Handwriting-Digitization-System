MONGO_URI=mongodb://127.0.0.1:27017/handwriting_digitizer
PORT=5000
JWT_SECRET=change_this_to_a_long_random_secret_for_development

# Set this to enable the optional Python TrOCR service.
HTR_SERVICE_URL=http://127.0.0.1:8000
# Set OCR_ENGINE=tesseract to force the existing fallback.
OCR_ENGINE=htr
